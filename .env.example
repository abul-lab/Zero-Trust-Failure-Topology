# Copy to .env and customize when running the HTTP service. Never commit .env.

# Optional shared secret required in the X-API-Key header on /v1/* endpoints
TOPOLOGY_API_KEY=

# Bind host and port for the HTTP service & Topology Console
TOPOLOGY_HOST=127.0.0.1
TOPOLOGY_PORT=4200

# Retry amplification factor above which a downstream node tips into overload
TOPOLOGY_OVERLOAD_MULTIPLIER=4

# Consecutive runtime fault events on a node before triggering zone quarantine
TOPOLOGY_QUARANTINE_THRESHOLD=3

